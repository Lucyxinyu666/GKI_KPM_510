diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index f458e56..4b20c3e 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -40,6 +40,14 @@ static char __user *ksud_user_path(void)
 
 
 #ifdef CONFIG_KSU_SUSFS
+/*
+ * Defined in policy/app_profile.c.  Apps keep the seccomp filter zygote gave
+ * them (so PR_GET_SECCOMP and /proc/self/status look stock), and the filter is
+ * released here - only in the child that is about to become su/ksud, because
+ * the Android app policy blocks the privileged syscalls a root shell needs.
+ */
+extern void disable_seccomp(void);
+
 /*
  * return 0 -> No further checks should be required afterwards
  * return non-zero -> Further checks should be continued afterwards
@@ -131,6 +139,12 @@ int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
 
     ret = escape_with_root_profile();
 
+    if (!ret) {
+        /* This task is about to exec ksud as root: drop the app seccomp filter
+         * for it alone, the calling app keeps its own. */
+        disable_seccomp();
+    }
+
     pr_info("ksu_handle_execveat_sucompat: su->ksud!\n");
     memcpy((void *)filename->name, ksud_path, sizeof(ksud_path));
 
