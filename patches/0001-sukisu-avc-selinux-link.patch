diff --git a/kernel/feature/avc_spoof.c b/kernel/feature/avc_spoof.c
new file mode 100644
index 0000000..14a3b79
--- /dev/null
+++ b/kernel/feature/avc_spoof.c
@@ -0,0 +1,219 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Adapted from KOWX712/KernelSU avc spoofing (GPL-2.0-only). */
+#include <linux/security.h>
+#include <linux/atomic.h>
+#include <linux/version.h>
+#include <linux/string.h>
+#include <linux/printk.h>
+#include <linux/kprobes.h>
+#include <linux/slab.h>
+
+#include "policy/feature.h"
+#include "feature/avc_spoof.h"
+#include "klog.h"
+#include "arch.h"
+
+/*
+ * AVC logging receives a target SID.  This feature changes only the SID used
+ * for audit rendering; it does not change the AVC decision or SELinux policy.
+ */
+static u32 su_sid;
+static u32 ksu_sid;
+static u32 priv_app_sid;
+
+/* Disabled until SIDs are resolved and the boot-completed hook installs the probe. */
+static atomic_t disable_spoof = ATOMIC_INIT(1);
+static bool ksu_avc_spoof_enabled = true;
+static bool avc_spoof_boot_completed;
+
+static struct kprobe *slow_avc_audit_kp;
+
+static int slow_avc_audit_pre_handler(struct kprobe *p, struct pt_regs *regs)
+{
+    u32 *tsid;
+
+    if (atomic_read(&disable_spoof))
+        return 0;
+
+    /*
+     * slow_avc_audit changed ABI across Android/Linux versions:
+     *   < 6.4: tsid is the third argument
+     * >= 6.4: tsid is the second argument
+     *
+     * This matches the upstream implementation and keeps the probe from
+     * writing to the state/ssid argument on newer kernels.
+     */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
+    tsid = (u32 *)&PT_REGS_PARM2(regs);
+#else
+    tsid = (u32 *)&PT_REGS_PARM3(regs);
+#endif
+
+    if (*tsid == su_sid || *tsid == ksu_sid) {
+        pr_info_ratelimited("avc_spoof: replace tsid %u with %u\n", *tsid, priv_app_sid);
+        *tsid = priv_app_sid;
+    }
+    return 0;
+}
+
+static struct kprobe *init_avc_kprobe(const char *name, kprobe_pre_handler_t handler)
+{
+    struct kprobe *kp = kzalloc(sizeof(*kp), GFP_KERNEL);
+    int ret;
+
+    if (!kp)
+        return NULL;
+
+    kp->symbol_name = name;
+    kp->pre_handler = handler;
+    ret = register_kprobe(kp);
+    pr_info("avc_spoof: register_%s kprobe: %d\n", name, ret);
+    if (ret) {
+        kfree(kp);
+        return NULL;
+    }
+    return kp;
+}
+
+static void destroy_avc_kprobe(struct kprobe **kp_ptr)
+{
+    struct kprobe *kp = *kp_ptr;
+
+    if (!kp)
+        return;
+    unregister_kprobe(kp);
+    synchronize_rcu();
+    kfree(kp);
+    *kp_ptr = NULL;
+}
+
+static int avc_spoof_lookup_sid(const char *secdata, u32 *secid)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
+    /* 6.8 replaced the u32 out-argument with struct lsm_context. */
+    return -EOPNOTSUPP;
+#else
+    return security_secctx_to_secid(secdata, strlen(secdata), secid);
+#endif
+}
+
+static int get_avc_sids(void)
+{
+    int ret;
+
+    ret = avc_spoof_lookup_sid("u:r:su:s0", &su_sid);
+    if (ret) {
+        pr_info("avc_spoof: su SID not found\n");
+        return ret;
+    }
+    pr_info("avc_spoof: su SID: %u\n", su_sid);
+
+    ret = avc_spoof_lookup_sid("u:r:ksu:s0", &ksu_sid);
+    if (ret) {
+        pr_info("avc_spoof: ksu SID not found\n");
+        return ret;
+    }
+    pr_info("avc_spoof: ksu SID: %u\n", ksu_sid);
+
+    ret = avc_spoof_lookup_sid("u:r:priv_app:s0:c512,c768", &priv_app_sid);
+    if (ret) {
+        pr_info("avc_spoof: priv_app SID not found\n");
+        return ret;
+    }
+    pr_info("avc_spoof: priv_app SID: %u\n", priv_app_sid);
+    return 0;
+}
+
+void ksu_avc_spoof_disable(void)
+{
+    pr_info("avc_spoof: unregister slow_avc_audit kprobe\n");
+    destroy_avc_kprobe(&slow_avc_audit_kp);
+    atomic_set(&disable_spoof, 1);
+    pr_info("avc_spoof: slow_avc_audit spoofing disabled\n");
+}
+
+void ksu_avc_spoof_enable(void)
+{
+    int ret = get_avc_sids();
+
+    if (ret) {
+        pr_info("avc_spoof: SID resolution failed: %d\n", ret);
+        return;
+    }
+
+    if (!slow_avc_audit_kp) {
+        pr_info("avc_spoof: register slow_avc_audit kprobe\n");
+        slow_avc_audit_kp = init_avc_kprobe("slow_avc_audit", slow_avc_audit_pre_handler);
+        if (!slow_avc_audit_kp) {
+            atomic_set(&disable_spoof, 1);
+            pr_err("avc_spoof: failed to register slow_avc_audit kprobe\n");
+            return;
+        }
+    }
+    atomic_set(&disable_spoof, 0);
+    pr_info("avc_spoof: slow_avc_audit spoofing enabled\n");
+}
+
+static int avc_spoof_feature_get(u64 *value)
+{
+    *value = ksu_avc_spoof_enabled ? 1 : 0;
+    return 0;
+}
+
+static int avc_spoof_feature_set(u64 value)
+{
+    bool enable = value != 0;
+
+    if (enable == ksu_avc_spoof_enabled) {
+        pr_info("avc_spoof: no need to change\n");
+        return 0;
+    }
+
+    ksu_avc_spoof_enabled = enable;
+    if (avc_spoof_boot_completed) {
+        if (enable)
+            ksu_avc_spoof_enable();
+        else
+            ksu_avc_spoof_disable();
+    }
+    pr_info("avc_spoof: set to %d\n", enable);
+    return 0;
+}
+
+static const struct ksu_feature_handler avc_spoof_handler = {
+    .feature_id = KSU_FEATURE_AVC_SPOOF,
+    .name = "avc_spoof",
+    .get_handler = avc_spoof_feature_get,
+    .set_handler = avc_spoof_feature_set,
+};
+static bool avc_spoof_registered;
+
+void ksu_avc_spoof_late_init(void)
+{
+    avc_spoof_boot_completed = true;
+    if (ksu_avc_spoof_enabled)
+        ksu_avc_spoof_enable();
+}
+
+void ksu_avc_spoof_init(void)
+{
+    if (!IS_ENABLED(CONFIG_KPROBES)) {
+        pr_warn("avc_spoof: CONFIG_KPROBES is disabled; feature unavailable\n");
+        return;
+    }
+    if (ksu_register_feature_handler(&avc_spoof_handler)) {
+        pr_err("avc_spoof: failed to register feature handler\n");
+        return;
+    }
+    avc_spoof_registered = true;
+}
+
+void ksu_avc_spoof_exit(void)
+{
+    if (ksu_avc_spoof_enabled)
+        ksu_avc_spoof_disable();
+    if (avc_spoof_registered) {
+        ksu_unregister_feature_handler(KSU_FEATURE_AVC_SPOOF);
+        avc_spoof_registered = false;
+    }
+}
diff --git a/kernel/feature/avc_spoof.h b/kernel/feature/avc_spoof.h
new file mode 100644
index 0000000..865b58c
--- /dev/null
+++ b/kernel/feature/avc_spoof.h
@@ -0,0 +1,8 @@
+#ifndef __KSU_H_AVC_SPOOF
+#define __KSU_H_AVC_SPOOF
+
+void ksu_avc_spoof_init(void);
+void ksu_avc_spoof_late_init(void);
+void ksu_avc_spoof_exit(void);
+
+#endif
diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
index ca0c04a..98a2eeb 100644
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -22,6 +22,8 @@
 #include "avc.h"
 #include "klog.h" // IWYU pragma: keep
 #include "objsec.h"
+#include "infra/symbol_resolver.h"
+#include "hook/patch_memory.h"
 
 
 static DEFINE_MUTEX(selinux_hide_mutex);
@@ -79,6 +81,24 @@ static void (*context_struct_compute_av_fn)(struct policydb *policydb, struct co
 #define ksu_task_security_struct cred_security_struct
 #endif
 
+/*
+ * selinuxfs dispatches /context and /access writes through the const table
+ *
+ *   static ssize_t (*const write_op[])(struct file *, char *, size_t)
+ *
+ * so the only way to intercept them is to swap the two table entries.  The
+ * table lives in .rodata, hence ksu_patch_text().
+ */
+typedef ssize_t (*ksu_write_op_fn)(struct file *, char *, size_t);
+
+static ksu_write_op_fn *selinux_write_op;
+static ksu_write_op_fn *context_write_slot;
+static ksu_write_op_fn *access_write_slot;
+static ksu_write_op_fn orig_context_write;
+static ksu_write_op_fn orig_access_write;
+static bool context_write_hooked;
+static bool access_write_hooked;
+
 ssize_t my_write_context(struct file *file, char *buf, size_t size)
 {
     char *canon = NULL;
@@ -121,6 +141,9 @@ ssize_t my_write_access(struct file *file, char *buf, size_t size)
     struct av_decision avd;
     ssize_t length;
 
+    if (access_write_hooked && orig_access_write && current_uid().val < 10000)
+        return orig_access_write(file, buf, size);
+
     length = ksu_avc_has_perm_compat(current_sid(), SECINITSID_SECURITY, SECCLASS_SECURITY, SECURITY__COMPUTE_AV, NULL);
     if (length)
         goto out;
@@ -166,6 +189,67 @@ out:
     return length;
 }
 
+static int ksu_selinux_hide_hook_write_op(void)
+{
+    ksu_write_op_fn fn;
+    int ret;
+
+    if (access_write_hooked)
+        return 0;
+
+    if (!selinux_write_op) {
+        selinux_write_op = (ksu_write_op_fn *)find_kernel_symbol_exact("write_op");
+        if (!selinux_write_op) {
+            pr_err("selinux_hide: write_op not found, /access stays unpatched\n");
+            return -ENOSYS;
+        }
+        context_write_slot = &selinux_write_op[SEL_CONTEXT];
+        access_write_slot = &selinux_write_op[SEL_ACCESS];
+    }
+
+    orig_context_write = *context_write_slot;
+    orig_access_write = *access_write_slot;
+
+    fn = my_write_context;
+    ret = ksu_patch_text(context_write_slot, &fn, sizeof(fn), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (ret) {
+        pr_err("selinux_hide: hook /context failed: %d\n", ret);
+        return ret;
+    }
+    context_write_hooked = true;
+
+    fn = my_write_access;
+    ret = ksu_patch_text(access_write_slot, &fn, sizeof(fn), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (ret) {
+        pr_err("selinux_hide: hook /access failed: %d\n", ret);
+        fn = orig_context_write;
+        ksu_patch_text(context_write_slot, &fn, sizeof(fn), KSU_PATCH_TEXT_FLUSH_DCACHE);
+        context_write_hooked = false;
+        return ret;
+    }
+    access_write_hooked = true;
+
+    pr_info("selinux_hide: write_op hooked, /access and /context are spoofed\n");
+    return 0;
+}
+
+static void ksu_selinux_hide_unhook_write_op(void)
+{
+    ksu_write_op_fn fn;
+
+    if (access_write_hooked && access_write_slot) {
+        fn = orig_access_write;
+        if (!ksu_patch_text(access_write_slot, &fn, sizeof(fn), KSU_PATCH_TEXT_FLUSH_DCACHE))
+            access_write_hooked = false;
+    }
+    if (context_write_hooked && context_write_slot) {
+        fn = orig_context_write;
+        if (!ksu_patch_text(context_write_slot, &fn, sizeof(fn), KSU_PATCH_TEXT_FLUSH_DCACHE))
+            context_write_hooked = false;
+    }
+    pr_info("selinux_hide: write_op restored\n");
+}
+
 /*
  * get the security ID of a set of credentials
  */
@@ -346,12 +430,20 @@ void ksu_selinux_hide_handle_post_fs_data()
 
 static int ksu_selinux_hide_enable()
 {
+    int ret;
+
     pr_info("selinux_hide: init selinux hide\n");
     if (!backup_sepolicy) {
         pr_err("no backup sepolicy available, please save feature and reboot to retry!\n");
         return -EAGAIN;
     }
 
+    ret = ksu_selinux_hide_hook_write_op();
+    if (ret) {
+        pr_err("selinux_hide: failed to hook selinuxfs write handlers: %d\n", ret);
+        return ret;
+    }
+
     return 0;
 }
 
@@ -377,6 +469,7 @@ static int selinux_hide_feature_set(u64 value)
         }
     } else {
         if (ksu_selinux_hide_running) {
+            ksu_selinux_hide_unhook_write_op();
             ksu_selinux_hide_running = false;
         }
     }
@@ -405,6 +498,7 @@ void __exit ksu_selinux_hide_exit()
 {
     mutex_lock(&selinux_hide_mutex);
     if (ksu_selinux_hide_running) {
+        ksu_selinux_hide_unhook_write_op();
         ksu_selinux_hide_running = false;
     }
     mutex_unlock(&selinux_hide_mutex);
diff --git a/kernel/hook/arm64/patch_memory.c b/kernel/hook/arm64/patch_memory.c
new file mode 100644
index 0000000..4522992
--- /dev/null
+++ b/kernel/hook/arm64/patch_memory.c
@@ -0,0 +1,177 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (C) 2023 bmax121. All Rights Reserved.
+ *
+ * Poke any kernel address (rodata, function-pointer tables, text) through a
+ * fixmap alias while every CPU is stopped.  Used by feature/selinux_hide.c to
+ * swap the selinuxfs write handlers.
+ */
+
+#ifdef __aarch64__
+
+#include "../patch_memory.h"
+#include "klog.h" // IWYU pragma: keep
+#include "linux/cpumask.h"
+#include "linux/gfp.h" // IWYU pragma: keep
+#include "linux/mm.h"
+#include "linux/uaccess.h"
+#include "linux/stop_machine.h"
+#include "asm/cacheflush.h"
+#include "asm-generic/fixmap.h"
+
+/* Android 12 5.10 has no dcache_clean_inval_poc(), keep the fallback. */
+#ifndef KSU_NEW_DCACHE_FLUSH
+#define KSU_NEW_DCACHE_FLUSH 0
+#endif
+
+// Translate a kernel virtual address to a physical address by walking the
+// init_mm page tables. Returns the physical address on success, or writes
+// a non-zero error to *err.
+unsigned long phys_from_virt(unsigned long addr, int *err)
+{
+    struct mm_struct *mm = &init_mm;
+    pgd_t *pgd;
+    p4d_t *p4d;
+    pud_t *pud;
+    pmd_t *pmd;
+    pte_t *pte;
+
+    *err = 0;
+
+    pgd = pgd_offset(mm, addr);
+    if (pgd_none(*pgd) || pgd_bad(*pgd))
+        goto fail;
+
+    p4d = p4d_offset(pgd, addr);
+    if (p4d_none(*p4d) || p4d_bad(*p4d))
+        goto fail;
+#if defined(p4d_leaf)
+    if (p4d_leaf(*p4d)) {
+        return __p4d_to_phys(*p4d) + ((addr & ~P4D_MASK));
+    }
+#endif
+
+    pud = pud_offset(p4d, addr);
+    if (pud_none(*pud) || pud_bad(*pud))
+        goto fail;
+#if defined(pud_leaf)
+    if (pud_leaf(*pud)) {
+        return __pud_to_phys(*pud) + ((addr & ~PUD_MASK));
+    }
+#endif
+
+    pmd = pmd_offset(pud, addr);
+#if defined(pmd_leaf)
+    if (pmd_leaf(*pmd)) {
+        return __pmd_to_phys(*pmd) + ((addr & ~PMD_MASK));
+    }
+#endif
+
+    if (pmd_none(*pmd) || pmd_bad(*pmd))
+        goto fail;
+
+    pte = pte_offset_kernel(pmd, addr);
+    if (!pte)
+        goto fail;
+    if (!pte_present(*pte))
+        goto fail;
+
+    return __pte_to_phys(*pte) + ((addr & ~PAGE_MASK));
+
+fail:
+    *err = -ENOENT;
+    return 0;
+}
+
+#if KSU_NEW_DCACHE_FLUSH
+#define ksu_flush_dcache(start, sz)                                                                                    \
+    ({                                                                                                                 \
+        unsigned long __start = (start);                                                                               \
+        unsigned long __end = __start + (sz);                                                                          \
+        dcache_clean_inval_poc(__start, __end);                                                                        \
+    })
+#define ksu_flush_icache(start, end) caches_clean_inval_pou(start, end)
+#else
+#define ksu_flush_dcache(start, sz) __flush_dcache_area((void *)start, sz)
+#define ksu_flush_icache(start, end) __flush_icache_range(start, end)
+#endif
+
+struct patch_text_info {
+    void *dst;
+    void *src;
+    size_t len;
+    atomic_t cpu_count;
+    int flags;
+};
+
+// Runs under stop_machine; propagate errors without console output.
+static int ksu_patch_text_nosync(void *dst, void *src, size_t len, int flags)
+{
+    unsigned long p = (unsigned long)dst;
+    int ret;
+
+    int phy_err;
+    unsigned long phy = phys_from_virt(p, &phy_err);
+    if (phy_err) {
+        ret = phy_err;
+        goto err;
+    }
+
+    void *map = set_fixmap_offset(FIX_TEXT_POKE0, phy);
+
+    ret = (int)copy_to_kernel_nofault(map, src, len);
+
+    clear_fixmap(FIX_TEXT_POKE0);
+
+    if (!ret) {
+        if (flags & KSU_PATCH_TEXT_FLUSH_ICACHE)
+            ksu_flush_icache((uintptr_t)dst, (uintptr_t)dst + len);
+        if (flags & KSU_PATCH_TEXT_FLUSH_DCACHE)
+            ksu_flush_dcache(dst, len);
+    }
+
+err:
+    return ret;
+}
+
+static int ksu_patch_text_cb(void *arg)
+{
+    struct patch_text_info *pp = arg;
+    void *dst = pp->dst, *src = pp->src;
+    size_t len = pp->len;
+    int flags = pp->flags;
+
+    int ret = 0;
+
+    /* The last CPU becomes master */
+    if (atomic_inc_return(&pp->cpu_count) == num_online_cpus()) {
+        ret = ksu_patch_text_nosync(dst, src, len, flags);
+        /* Notify other processors with an additional increment. */
+        atomic_inc(&pp->cpu_count);
+    } else {
+        while (atomic_read(&pp->cpu_count) <= num_online_cpus())
+            cpu_relax();
+        isb();
+    }
+
+    return ret;
+}
+
+int ksu_patch_text(void *dst, void *src, size_t len, int flags)
+{
+    int ret;
+    struct patch_text_info info = {
+        .dst = dst,
+        .src = src,
+        .len = len,
+        .cpu_count = ATOMIC_INIT(0),
+        .flags = flags,
+    };
+
+    ret = stop_machine(ksu_patch_text_cb, &info, cpu_online_mask);
+    if (ret)
+        pr_err("failed to patch kernel address 0x%lx: %d\n", (unsigned long)dst, ret);
+    return ret;
+}
+
+#endif /* __aarch64__ */
